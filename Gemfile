source "https://rubygems.org"

gem "autoprefixer-rails"
gem "image_optim"
gem "jekyll", '3.8.6'
gem "jekyll-assets"
gem "jekyll-sitemap"
gem "jemoji"
gem "mini_magick"
gem "sass"
gem "sprockets", "~> 3.7"
gem "uglifier"

# Jekyll 3.8 runs on Ruby 2.6 (the jekyll/jekyll:3.8 image). Newer releases of
# these transitive dependencies require Ruby 3, so keep them at versions that
# still install there. Gemfile.lock is committed so every build resolves alike.
gem "ffi", "< 1.16"
gem "nokogiri", "< 1.13"
gem "public_suffix", "< 5"
gem "faraday", "< 2"
